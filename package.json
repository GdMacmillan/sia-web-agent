{
  "name": "@sia-web/agent",
  "version": "0.14.1",
  "description": "SIA agent runtime — a LangGraph deep-agent with prompts, skills, and tool middleware. Extracted from sia-web.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdmacmillan/sia-web-agent.git"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "jest --testPathPatterns='tests/(unit|integration|debugging)' --testPathIgnorePatterns='integration|tests/unit/code-interpreter' && yarn test:interpreter",
    "test:unit": "jest --testPathPatterns='tests/(unit|integration|debugging)' --testPathIgnorePatterns='integration|tests/unit/code-interpreter'",
    "test:interpreter": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.interpreter.js",
    "test:integration": "RUN_INTEGRATION=true jest tests/integration --forceExit",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "sync:seed": "node scripts/sync-seed-components.mjs",
    "measure:prompt": "tsx scripts/measure-prompt-budget.ts"
  },
  "dependencies": {
    "@huggingface/inference": "4.13.32",
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "^0.32.0",
    "@langchain/community": "1.1.29",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint": "1.1.6",
    "@langchain/mcp-adapters": "1.1.4",
    "@langchain/openai": "1.6.2",
    "@langchain/openrouter": "0.4.17",
    "@sveltejs/acorn-typescript": "^1.0.13",
    "@tavily/core": "0.7.14",
    "@vscode/ripgrep": "1.18.0",
    "acorn": "^8.19.0",
    "axios": "1.20.0",
    "dedent": "^1.7.1",
    "dotenv": "18.0.7",
    "estree-walker": "^3.0.3",
    "fast-glob": "3.3.3",
    "json-schema-to-typescript": "^16.0.0",
    "langchain": "1.5.16",
    "langsmith": "0.10.11",
    "magic-string": "^1.4.3",
    "micromatch": "4.0.8",
    "openai": "7.32.0",
    "p-queue": "^9.3.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "quickjs-emscripten": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "safe-regex": "^2.1.1",
    "semver": "^7",
    "tsx": "^4.23.15",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/estree": "^1.0.9",
    "@types/jest": "^30.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.5",
    "@types/safe-regex": "^1.1.6",
    "@types/semver": "^7.8.0",
    "@types/uuid": "^11.0.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
